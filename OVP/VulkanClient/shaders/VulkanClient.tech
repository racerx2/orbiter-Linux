// VulkanClient.tech -- the technique table.
// Part of the ORBITER VISUALISATION PROJECT (OVP)
// Dual licensed under GPL v3 and LGPL v3
// Copyright (C) 2011-2026 Jarmo Nikkanen
// ===========================================================================
//
// EVERY BLOCK BELOW IS COPIED VERBATIM FROM THE .fx FILE THAT DECLARED IT.
// Nothing here is new and nothing has been reordered or renamed; each block
// carries the file and line it came from so it can be diffed against the
// reference.
//
// WHY IT IS A SEPARATE FILE NOW. D3DXCreateEffectFromFileA compiled one .fx
// into an object holding both the shaders and these technique declarations,
// because its compiler understood both halves of the language. glslang
// understands only the shader half -- GLSL has no `technique` and no render
// state -- so the two halves are two files. They are still both DATA, still
// read at load time, and a technique's blend or depth mode is still changed
// by editing a file rather than by rebuilding the client. That property is
// the reason this is a file at all rather than a table in VulkanEffect.cpp.
//
// The `compile vs_3_0` / `compile ps_3_0` words are kept exactly as the
// reference writes them, and the parser skips them: SPIR-V has no shader
// profiles, so the entry-point name is all that survives of those lines. They
// are left in place so this file stays diffable against the .fx sources.
//
// The state names are the ones the reference uses and are translated in
// VulkanEffect.cpp -- ParseBlendFactor, ParseBlendOp, ParseCompareOp,
// ParseStencilOp and ParseCullMode. A name that appears here and not there is
// reported by name at load time rather than defaulting silently.
//
// TWO TECHNIQUES THE CLIENT LOOKS UP ARE NOT HERE AND WERE NEVER ANYWHERE:
// SkyDomeTech and BaseShadowTech. Searched across all eleven .fx files of the
// reference; they exist only as the two GetTechniqueByName calls in
// D3D9Effect.cpp, which have therefore returned NULL for the life of the
// client. See the note in VulkanEffect::VulkanTechInit.
//
// THE SAMPLER_STATE BLOCKS ARE HERE FOR THE SAME REASON THE TECHNIQUES ARE.
// `sampler_state` is D3DX effect-framework syntax, not HLSL: glslang has no
// idea what AddressU or MaxAnisotropy mean, because in GLSL a sampler IS the
// combination of an image and its state and carries none of it in the source.
// So the blocks are transcribed verbatim from D3D9Client.fx, in its order,
// and VulkanEffectFile builds one VkSampler per block.
//
// The `= sampler_state` between the name and the brace is dropped -- the
// `sampler` keyword already said it, and the parser skips it either way.
//
// `Texture = <gTex0>` is what makes FX->SetTexture(eTex0, ...) work: it is
// the join between a texture parameter, which the client sets by name, and
// the bindings that read it. Eight of these blocks name gTex0.
// ===========================================================================


// ---------------------------------------------------------------------------
// Texture Sampler implementations -- from D3D9Client.fx
// ---------------------------------------------------------------------------

sampler IrradS                      // Irradiance map sampler
{
	Texture = <gIrradianceMap>;
	MinFilter = LINEAR;
	MagFilter = LINEAR;
	MipFilter = LINEAR;
	AddressU = CLAMP;
	AddressV = CLAMP;
};

sampler ShadowS                     // Shadow map sampler
{
	Texture = <gShadowMap>;
	MinFilter = POINT;
	MagFilter = POINT;
	MipFilter = POINT;
	AddressU = CLAMP;
	AddressV = CLAMP;
};

sampler WrapS                       // Primary Mesh texture sampler
{
	Texture = <gTex0>;
	MinFilter = ANISOTROPIC;
	MagFilter = LINEAR;
	MipFilter = LINEAR;
	MaxAnisotropy = ANISOTROPY_MACRO;
	MipMapLODBias = 0;
	AddressU = WRAP;
	AddressV = WRAP;
};

sampler ClampS                      // Base tile sampler
{
	Texture = <gTex0>;
	MinFilter = ANISOTROPIC;
	MagFilter = LINEAR;
	MipFilter = LINEAR;
	MaxAnisotropy = ANISOTROPY_MACRO;
	MipMapLODBias = 0;
	AddressU = CLAMP;
	AddressV = CLAMP;
};

sampler SpecS                       // Primary Mesh texture sampler
{
	Texture = <gSpecMap>;
	MinFilter = ANISOTROPIC;
	MagFilter = LINEAR;
	MipFilter = LINEAR;
	MaxAnisotropy = ANISOTROPY_MACRO;
	MipMapLODBias = 0;
	AddressU = WRAP;
	AddressV = WRAP;
};

